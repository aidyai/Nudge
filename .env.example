# Copy to .env.local to run on your machine. On Vercel, add these under Project Settings, Environment Variables.
# They are read on the server only. Nothing here starts with NEXT_PUBLIC_, so nothing reaches the browser.

# Where the engine API runs. Locally: http://localhost:8000. On Modal: https://<workspace>--nudge-api-web.modal.run
ENGINE_URL=
# Must match API_KEY in the engine's settings
ENGINE_API_KEY=
